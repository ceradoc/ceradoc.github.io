---
import Base from "../layouts/Base.astro";
import SealMark from "../components/SealMark.astro";

const gems = [
  {
    name: "ceradoc",
    role: "The CoreModel hub — the canonical document model every format passes through",
  },
  {
    name: "ceradoc-adoc",
    role: "AsciiDoc front — PARG grammar, parse to CoreModel, rebuild from CoreModel",
  },
  {
    name: "ceradoc-markdown",
    role: "Markdown front — PARG grammar, parse to CoreModel, rebuild from CoreModel",
  },
  {
    name: "ceradoc-html",
    role: "HTML renderer — the CoreModel pressed into clean, styled markup",
  },
  {
    name: "ceradoc-docx",
    role: "DOCX renderer — the CoreModel pressed into WordprocessingML",
  },
  {
    name: "ceradoc-mirror",
    role: "ProseMirror-compatible JSON mirror of the CoreModel",
  },
];

const seals = [
  {
    mark: "Identity",
    body: "The document keeps its name. Headings, authored IDs, front matter and document attributes survive every trip through the hub.",
  },
  {
    mark: "Integrity",
    body: "Nothing added, nothing invented. Unsupported constructs are rejected explicitly instead of silently rewritten.",
  },
  {
    mark: "Permanence",
    body: "A sealed document re-opens as itself. Round trips are byte-stable, and the harness catalogues any seal that ever leaks.",
  },
];
---

<Base title="Ceradoc — the seal of interoperable document information">
  <section class="mx-auto max-w-4xl px-6 pt-24 pb-16 text-center">
    <div class="mb-10 flex justify-center">
      <SealMark size={180} pressed />
    </div>
    <h1 class="font-display text-5xl font-black tracking-tight md:text-6xl">
      Interoperable document information,
      <span class="italic text-wax">sealed.</span>
    </h1>
    <p class="mx-auto mt-6 max-w-2xl text-lg leading-relaxed text-dim">
      <span class="font-semibold text-ink">Cera</span> is Latin for
      <i>wax</i> — the sealing wax pressed into documents to mark them
      authentic. <span class="font-semibold text-ink">Ceradoc</span> parses
      AsciiDoc and Markdown into one canonical CoreModel, then presses that
      model into any format: faithful, verifiable, round-trip-intact.
    </p>
    <div class="mt-8 flex flex-wrap justify-center gap-4">
      <a
        href="/guide/getting-started"
        class="rounded-lg bg-wax px-6 py-3 font-semibold text-ink transition hover:bg-waxdeep"
      >
        Press your first document
      </a>
      <a
        href="https://github.com/ceradoc/ceradoc"
        class="rounded-lg border border-line px-6 py-3 font-medium text-ink transition hover:border-dim"
      >
        Source on GitHub
      </a>
    </div>
  </section>

  <section class="mx-auto max-w-5xl px-6 py-10">
    <div class="rounded-2xl border border-line bg-panel p-8">
      <div class="grid items-center gap-8 md:grid-cols-3">
        <div class="text-center">
          <p class="font-display text-xl font-bold text-ink">AsciiDoc</p>
          <p class="font-mono text-xs text-dim">.adoc</p>
        </div>
        <div class="text-center">
          <p class="font-display text-3xl font-black text-wax">⇄</p>
          <p class="mt-1 font-mono text-xs uppercase tracking-widest text-dim">CoreModel</p>
        </div>
        <div class="text-center">
          <p class="font-display text-xl font-bold text-ink">Markdown</p>
          <p class="font-mono text-xs text-dim">.md</p>
        </div>
      </div>
      <div class="mt-6 border-t border-line pt-6 text-center">
        <p class="text-sm text-dim">
          One hub, every direction: the same CoreModel also presses into
          <span class="text-ink">HTML</span>, <span class="text-ink">DOCX</span>
          and <span class="text-ink">ProseMirror JSON</span>.
        </p>
      </div>
    </div>
  </section>

  <section class="mx-auto max-w-5xl px-6 py-12">
    <h2 class="font-display text-2xl font-black">What the seal guarantees</h2>
    <div class="mt-6 grid gap-4 md:grid-cols-3">
      {
        seals.map((item) => (
          <div class="rounded-xl border border-line bg-panel p-6">
            <p class="font-display text-lg font-bold text-brass">{item.mark}</p>
            <p class="mt-2 text-sm leading-relaxed text-dim">{item.body}</p>
          </div>
        ))
      }
    </div>
  </section>

  <section class="mx-auto max-w-5xl px-6 py-12">
    <h2 class="font-display text-2xl font-black">The six seals</h2>
    <p class="mt-2 text-dim">One gem per press — the hub, the two parsers, the three presses.</p>
    <div class="mt-6 grid gap-4 md:grid-cols-2">
      {
        gems.map((gem) => (
          <a
            href={`https://rubygems.org/gems/${gem.name}`}
            class="rounded-xl border border-line bg-panel p-6 transition hover:border-wax"
          >
            <div class="flex items-baseline justify-between gap-4">
              <code class="font-mono font-semibold text-ink">{gem.name}</code>
              <img
                src={`https://img.shields.io/gem/v/${gem.name}`}
                alt={`${gem.name} version`}
                class="h-4"
              />
            </div>
            <p class="mt-2 text-sm leading-relaxed text-dim">{gem.role}</p>
          </a>
        ))
      }
    </div>
  </section>

  <section class="mx-auto max-w-5xl px-6 py-12">
    <h2 class="font-display text-2xl font-black">Press one yourself</h2>
    <div class="mt-6 rounded-xl border border-line bg-panel p-6 font-mono text-sm leading-7">
      <p><span class="text-patina">$</span> gem install ceradoc-adoc ceradoc-html</p>
      <p><span class="text-patina">$</span> ceradoc parse document.adoc --to core</p>
      <p><span class="text-patina">$</span> ceradoc convert document.adoc -t html</p>
      <p class="mt-3 text-dim">
        # the document comes back sealed — see
        <a href="/guide/round-trip" class="text-patina hover:underline">the round-trip guarantee</a>
      </p>
    </div>
  </section>
</Base>
